OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_ROUTER_MODEL=claude-haiku-4-5-20251001
# Output token cap for CLAUDE_MODEL (Sonnet) generation calls - the main
# lever on Sonnet spend. Router/groundedness stay on CLAUDE_ROUTER_MODEL
# with their own small fixed caps, so this doesn't affect them.
CLAUDE_MAX_TOKENS=1024

CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE_KEY=LLMKB

DOMAIN_DESCRIPTION=the global LLM landscape: models, providers, release dates, context windows, licensing, benchmarks

STORAGE_MODE=local
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=kb_chunks
BM25_INDEX_PATH=./bm25_index.pkl

# Default: local SQLite, zero setup. Swap for a Neon Postgres URL only if you
# want audit history to survive across deployed sessions. Don't use Supabase
# (its free tier pauses the whole project after 7 days idle and needs a
# manual unpause - Neon auto-resumes on the next query instead).
DATABASE_URL=sqlite:///./local.db

# Which golden set app.py's example-question buttons and "Run eval now"
# sidebar action read from. Defaults to the real golden set CI scores on
# every PR; point this at a demo-only copy (e.g. eval/demo_golden_set.jsonl)
# to add example questions without touching what the release gate scores.
GOLDEN_SET_PATH=eval/golden_set.jsonl

RETRIEVE_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60

# Optional: live web search for the "needs current info" route (tavily.com).
# Leave blank to answer those from Claude's general knowledge instead.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
