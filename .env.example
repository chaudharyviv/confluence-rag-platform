# --- LLM providers (required) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_ROUTER_MODEL=claude-haiku-4-5-20251001

# --- Confluence source (required) ---
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE_KEY=LLMKB

# --- Domain / routing ---
DOMAIN_DESCRIPTION=the global LLM landscape: models, providers, release dates, context windows, licensing, benchmarks

# --- Vector storage ---
# local: reindex writes directly to disk (laptop, VPS, anything with a persistent volume)
# git:   reindex commits chroma_db/ + bm25_index.pkl back to the repo (ephemeral hosts like Streamlit Community Cloud)
STORAGE_MODE=local
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=kb_chunks
BM25_INDEX_PATH=./bm25_index.pkl

# --- Relational storage (audit log, eval history, sync state) ---
# Default: local SQLite, zero setup. Swap for a Neon Postgres URL only if you
# want audit history to survive across deployed sessions. Do not use Supabase
# for this (its free tier pauses the whole project after 7 days idle and
# needs a manual unpause - Neon auto-resumes on the next query instead).
DATABASE_URL=sqlite:///./local.db

# --- Retrieval tuning ---
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60

# --- Optional: external fallback for out-of-date/out-of-scope questions ---
SERPAPI_API_KEY=
